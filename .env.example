# Supabase PostgreSQL connection string (server-side only; never prefix with NEXT_PUBLIC_).
# Use the Supabase transaction pooler connection string for Vercel deployments.
SUPABASE_DB_URL=postgresql://postgres.PROJECT_REF:DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require

# Cloudinary server-side credentials
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Used only to create the first administrator when logging in for the first time.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password
BOOTSTRAP_ORGANIZATION_ID=default-organization
BOOTSTRAP_ORGANIZATION_NAME=Minha organização
